{
    "name":  "drazy",
    "private":  true,
    "scripts":  {
                    "i":  "turbo run i",
                    "build":  "turbo run build",
                    "dev":  "turbo run dev",
                    "lint":  "turbo run lint",
                    "format":  "prettier --write \"**/*.{ts,tsx,md}\"",
                    "check-types":  "turbo run check-types",
                    "migrate":  "turbo run migrate --filter=@repo/db",
                    "generate":  "turbo run generate --filter=@repo/db"
                },
    "devDependencies":  {
                            "prettier":  "^3.9.6",
                            "turbo":  "^2.10.7",
                            "typescript":  "^5.9.3"
                        },
    "packageManager":  "pnpm@9.0.0",
    "engines":  {
                    "node":  "\u003e=18"
                },
    "dependencies":  {
                         "pnpm":  "^11.18.0"
                     },
    "pnpm.overrides":  {
                           "sharp":  "^0.35.0",
                           "postcss":  "^8.5.18",
                           "brace-expansion":  "^1.1.18"
                       }
}
